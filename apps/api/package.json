{
  "name": "@helixa/multipass-api",
  "version": "0.1.0",
  "description": "Memory-backed API boundary primitives for Multipass profiles and agent-readable documents.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "dependencies": {
    "@helixa/multipass-sdk": "workspace:*",
    "@xmtp/node-sdk": "6.1.0",
    "viem": "^2.53.1"
  },
  "files": [
    "README.md",
    "src",
    "fixtures"
  ],
  "scripts": {
    "start": "node src/server.js",
    "xmtp:worker": "node src/xmtp-worker/run.js",
    "sibyl:prove-cold-start": "node scripts/prove-sibyl-cold-start.js",
    "loopers:allowlist:backup": "node scripts/backup-loopers-allowlist.js",
    "loopers:allowlist:export": "node scripts/export-loopers-allowlist.js",
    "loopers:allowlist:import-batch": "node scripts/import-loopers-allowlist-batch.js"
  }
}
